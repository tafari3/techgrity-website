# Production SMTP delivery
SMTP_HOST=mails.zchpc.ac.zw
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=website@techgrity.co.zw
SMTP_PASS=
SMTP_REJECT_UNAUTHORIZED=true

# Public website sender and internal recipient(s)
MAIL_FROM_EMAIL=website@techgrity.co.zw
ENQUIRY_TO_EMAIL=business@techgrity.co.zw

# Local/CI-only: validates success paths without sending email
FORM_DRY_RUN=0
